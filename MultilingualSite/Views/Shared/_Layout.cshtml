@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options

@* Впроваджуємо спільний локалізатор та налаштування культур *@
@inject IStringLocalizer<MultilingualSite.SharedResource> Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    // Отримуємо поточну культуру
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    
    // Формуємо список доступних культур
    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.NativeName })
        .ToList();
        
    // Визначаємо URL для повернення
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}";
}

<!DOCTYPE html>
<html lang="@requestCulture?.RequestCulture.UICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MultilingualSite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MultilingualSite.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Club" asp-action="Index">@Localizer["Back"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Club" asp-action="CreateClub">@Localizer["CreateLink"]</a>
                        </li>
                    </ul>
                    
                    <form asp-controller="Club" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post" class="d-flex align-items-center ms-auto">
                        <select name="culture" 
                                asp-for="@requestCulture!.RequestCulture.UICulture.Name" 
                                asp-items="cultureItems" 
                                class="form-select form-select-sm" 
                                style="width: auto;"
                                onchange="this.form.submit();">
                        </select>
                    </form>              
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - MultilingualSite - ASP.NET Core MVC Application
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>