@using Microsoft.Extensions.Localization
@model IEnumerable<MultilingualSite.Models.Club>
@* Впроваджуємо спільний локалізатор *@
@inject IStringLocalizer<MultilingualSite.SharedResource> Localizer

@{
    ViewBag.Title = Localizer["IndexHeader"];
}

<h2 class="mb-4">@Localizer["IndexHeader"]</h2>

<div class="table-responsive">
    <table class="table table-hover table-striped shadow-sm">
        <thead class="table-light">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.City)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Country)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.City)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Country)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>